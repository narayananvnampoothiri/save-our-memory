# ==========================================
# "Save Our Memory" Environment Configuration
# ==========================================

# Flask App Secret Key (Used for signing cookies and cryptographic tokens)
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Server Port and Host
PORT=5000
HOST=127.0.0.1
DEBUG=True

# Database Configuration
DATABASE_PATH=storage/database.sqlite

# Media Storage Directory (Isolated from public web root)
STORAGE_DIR=storage

# Upload Limits (in bytes, default 100MB)
MAX_CONTENT_LENGTH=104857600

# Auth Token Expiry in Hours
TOKEN_EXPIRE_HOURS=72

# Password Reset Code Expiry in Minutes
RESET_CODE_EXPIRE_MINUTES=15
